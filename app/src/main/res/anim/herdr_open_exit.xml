<?xml version="1.0" encoding="utf-8"?>
<!-- The screen underneath settles back as the new one arrives. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:shareInterpolator="true">
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" android:duration="320" />
    <alpha android:fromAlpha="1" android:toAlpha="0.4" android:duration="320" />
</set>
