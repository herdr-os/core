<?xml version="1.0" encoding="utf-8"?>
<!-- Back: the screen underneath comes forward again. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:shareInterpolator="true">
    <scale android:fromXScale="0.96" android:toXScale="1" android:fromYScale="0.96" android:toYScale="1"
        android:pivotX="50%" android:pivotY="50%" android:duration="300" />
    <alpha android:fromAlpha="0.4" android:toAlpha="1" android:duration="300" />
</set>
