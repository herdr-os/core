---
import "../styles/global.css";
import Screen from "../components/Screen.astro";

const harnesses = [
  { name: "Claude Code", sheep: "brand-claude", c: "var(--claude)", ink: "#141413", note: "Opus, Sonnet, Haiku" },
  { name: "Codex", sheep: "brand-codex", c: "var(--codex)", ink: "#0d0d0d", note: "GPT, any effort" },
  { name: "Pi", sheep: "brand-pi", c: "var(--pi)", ink: "#0b1a22", note: "Any provider" },
  { name: "OpenCode", sheep: "brand-opencode", c: "var(--opencode)", ink: "#f1ecec", note: "Read from its own store" },
];

const chapters = [
  { n: "01", tag: "Glance", title: "It sleeps until someone needs you.", body: "The R1 rests on the lock screen with a quiet count of who is working. Wake it and the companion tells you, in one breath, what happened while you were away.", chips: ["Asleep", "Spoken briefing", "Pasture"], screens: ["asleep", "briefing", "pasture"] },
  { n: "02", tag: "Answer", title: "Every question arrives as the sheep that asked it.", body: "Approvals float above the agent in its own colors. Your choice glows orange, and the R1 names exactly where the answer goes before anything is sent.", chips: ["Sheep asks", "Bound to the question", "Touch approves"], screens: ["asks"] },
  { n: "03", tag: "Talk", title: "Hold the button. It answers out loud.", body: "Walkie-talkie mode gives each agent a channel on the wheel. Your voice goes out in orange; its reply fills the screen in its brand color and is spoken back to you.", chips: ["Push to talk", "Channels on the wheel", "Spoken replies"], screens: ["walkie-you", "walkie-it"] },
  { n: "04", tag: "Show it", title: "Point at the whiteboard. The agent sees it.", body: "Snap a photo with the R1's camera. It lands on the agent's own machine, next to the code, and the agent reads it like any file.", chips: ["Camera", "Saved where the code is", "Thread"], screens: ["camera", "photo-sent", "thread"] },
  { n: "05", tag: "Supervise", title: "Subagents, tasks and a live terminal.", body: "See every subagent's latest step, every background command's last lines, and the terminal itself, sanitized, scrollable on the wheel.", chips: ["Subagents", "Background tasks", "Ghostty terminal"], screens: ["subagents", "tasks", "terminal"] },
  { n: "06", tag: "Steer", title: "Change models from your palm.", body: "Pick Opus, Sonnet or GPT and the effort to match. Herdr OS types the harness's own command, so nothing is faked. Or say a new task and choose who takes it.", chips: ["Model picker", "Effort", "New task"], screens: ["model", "new-task"] },
];
const screens = [...new Set(chapters.flatMap((c) => c.screens))];

const day = [
  { img: "dawn", t: "Dawn", time: "06:12" },
  { img: "pasture", t: "Day", time: "11:40" },
  { img: "dusk", t: "Dusk", time: "19:05" },
  { img: "night", t: "Night", time: "23:48" },
];

import manifest from "../../public/downloads/manifest.json";

const steps = [
  { where: "On the R1 and rabbit hole", time: "10 min", chrome: false, title: "Turn on developer mode and ask Rabbit to unlock", body: "In rabbit hole, under settings, r1, void the warranty to enable developer mode, then choose device modification, unlock. Rabbit's servers allow the unlock; nothing changes on the R1 yet." },
  { where: "", time: "2 min", chrome: true, title: "Unlock the bootloader", body: "Plug in the powered-off R1. The installer catches its preloader, puts it in fastboot and unlocks it. This wipes the R1." },
  { where: "", time: "10 min", chrome: true, title: "Flash LineageOS", body: "Turns verified boot off, wipes data the way Rabbit's restore does, removes Rabbit's launcher partition and writes the LineageOS GSI to the active slot." },
  { where: "", time: "3 min", chrome: true, title: "Root with Magisk", body: "Patches the R1's own boot image with Magisk, on the R1, and flashes it back. You get the unpatched image as a download, to undo it." },
  { where: "", time: "3 min", chrome: true, title: "Install Herdr OS", body: "Installs the Magisk module and the app, makes Herdr OS the home screen, sets the R1's defaults and reboots into the asleep screen." },
  { where: "On your computer", time: "5 min", chrome: false, title: "Run the bridge, scan the code", body: "Install the bridge where Herdr runs and start it; `herdr-bridge enroll --tailscale --qr` prints a code the R1 scans. Your speech key goes in on the R1, never through the website.", code: "npm i -g @herdr-os/bridge && herdr-bridge serve --tailscale" },
];

const sideways = [
  { img: "rate-limited", t: "Out of usage", d: "Wait for the reset, or finish on Sonnet with one confirmed tap." },
  { img: "context-full", t: "Context full", d: "Compact and keep going, before the agent forgets." },
  { img: "host-down", t: "A host goes quiet", d: "Last known, never pretend-live. Everyone else is fine." },
  { img: "answered", t: "Already answered", d: "Someone got there first. Nothing is sent twice." },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Herdr OS · a herd in your hand</title>
  <meta name="description" content="Herdr OS turns a Rabbit R1 into a pocket companion for the coding agents running on your machines: Claude Code, Codex, Pi and OpenCode." />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/sheep/sheep-plain.svg" type="image/svg+xml" />
  <meta property="og:title" content="Herdr OS · a herd in your hand" />
  <meta property="og:description" content="Glance at every coding agent, answer what's waiting and talk back, from a Rabbit R1." />
  <meta property="og:image" content="/og/pasture.webp" />
</head>
<body>
  <nav class="nav">
    <a class="brand" href="#top"><img src="/sheep/sheep-plain.svg" alt="" />Herdr<b>OS</b></a>
    <ul class="mono">
      <li><a href="#journeys">Journeys</a></li>
      <li><a href="#how">How it works</a></li>
      <li><a href="#install">Install</a></li>
    </ul>
    <a class="pill orange" href="/install">Install</a>
  </nav>

  <main id="top">
    <section class="wrap hero">
      <div>
        <p class="mono kicker dim">Herdr OS · for the Rabbit R1</p>
        <h1 class="display" data-split>
          <span class="line">Your agents,</span>
          <span class="line">a herd in</span>
          <span class="line orange">your hand.</span>
        </h1>
        <p class="lede" data-fade>Herdr OS turns a Rabbit R1 into a pocket companion for every Claude Code, Codex, Pi and OpenCode coding agent on your machines. Glance at the herd, answer what's waiting, and talk back, without opening a laptop.</p>
        <div class="ctas" data-fade>
          <a class="pill orange" href="#journeys">See it move</a>
          <a class="pill ghost" href="#install">Set it up</a>
        </div>
      </div>
      <div class="stage">
        <div class="ground"></div>
        <div class="r1" data-hero-r1>
          <div class="screen" role="img" aria-label="The Herdr OS pasture: agents as sheep, one asking a question"><Screen name="pasture" /></div>
          <div class="pocket cam"></div><div class="pocket wheel"><i data-wheel></i></div><div class="ptt"></div>
        </div>
        <img class="float-sheep" style="left:-4%;top:6%" src="/sheep/brand-claude.svg" alt="" data-float />
        <img class="float-sheep" style="right:-2%;top:-6%" src="/sheep/brand-pi.svg" alt="" data-float />
        <img class="float-sheep" style="right:-6%;bottom:2%" src="/sheep/brand-codex.svg" alt="" data-float />
        <img class="float-sheep" style="left:2%;bottom:-4%" src="/sheep/brand-opencode-sleep.svg" alt="" data-float />
      </div>
      <div class="scroll-cue mono dim"><span></span>Scroll</div>
    </section>

    <section class="wrap herd">
      <p class="mono orange">The herd</p>
      <h2 class="display section-title" data-words>One sheep per agent. Wool in its maker's colors.</h2>
      <div class="row">
        {harnesses.map((h) => (
          <div class="sheep-card" style={`--c:${h.c};--ink:${h.ink}`} data-card>
            <span class="mono">{h.note}</span>
            <img src={`/sheep/${h.sheep}.svg`} alt={`${h.name} sheep`} />
            <span class="name">{h.name}</span>
          </div>
        ))}
      </div>
      <p class="note dim">The plain sheep is the companion. It speaks for the herd; the branded ones speak for themselves. A sleeping sheep is idle, and the words always say so too.</p>
    </section>

    <section class="wrap principles" aria-label="Design principles">
      <p class="mono orange">Four rules</p>
      <div class="stmt display" data-reveal>Orange is you.<small>Your voice, your attention, anything waiting on you. Nothing else is ever orange.</small></div>
      <div class="stmt display" data-reveal>Wheel moves. Button talks. Touch approves.<small>Three controls, three jobs, no overlap, so muscle memory never sends the wrong thing.</small></div>
      <div class="stmt display" data-reveal>A spoken yes never approves.<small>Voice drafts, a finger decides. The side button can't answer a question by accident.</small></div>
      <div class="stmt display" data-reveal>No invented numbers.<small>Every model, token count and subagent comes from the agent's own session files. If nothing records it, the R1 doesn't show it.</small></div>
    </section>

    <section class="journeys" id="journeys" data-journeys>
      <div class="wrap pin">
        <div class="device">
          <div class="r1">
            <div class="screen">
              {screens.map((s, i) => <Screen name={s} hidden={i > 0} />)}
            </div>
            <div class="pocket cam"></div><div class="pocket wheel"><i data-wheel></i></div><div class="ptt"></div>
          </div>
        </div>
        <div class="chapters">
          {chapters.map((c) => (
            <article class="chapter" data-chapter data-screens={c.screens.join(",")}>
              <p class="mono"><span class="orange">{c.n}</span> <span class="dim">· {c.tag}</span></p>
              <h3 class="display">{c.title}</h3>
              <p>{c.body}</p>
              <ul class="mono dim">{c.chips.map((x) => <li>{x}</li>)}</ul>
            </article>
          ))}
          <div class="rail" aria-hidden="true">{chapters.map(() => <i><b /></i>)}</div>
        </div>
      </div>
    </section>

    <section class="wrap hosts">
      <div>
        <p class="mono orange">Every machine</p>
        <h2 class="display section-title" data-words>Every agent. Every machine. One glance.</h2>
        <p class="dim" style="margin-top:24px;max-width:44ch">Past six agents the pasture folds into a flock per host. Tap one and it opens as its own field; turn the wheel and walk the whole flock.</p>
        <div class="chips mono"><span>cerebro</span><span>macbook</span><span>namek</span></div>
      </div>
      <div class="shots" data-shots>
        <div class="shot frame" style="left:0;top:6%" role="img" aria-label="The pasture folded into one flock per host"><Screen name="flocks" /></div>
        <div class="shot frame" style="right:0;top:22%" role="img" aria-label="Every agent as a deck of harness-colored cards"><Screen name="cards" /></div>
      </div>
    </section>

    <section class="daytime" data-daytime aria-label="The pasture through the day">
      <div class="track">
        <div class="intro">
          <p class="mono orange">Keeps time</p>
          <h2 class="display section-title">The sky follows your clock.</h2>
          <p class="dim" style="margin-top:22px;max-width:36ch">Dawn, day, dusk and night. The sheep's colors and your orange never change with it; only the field does.</p>
        </div>
        {day.map((d) => (
          <figure data-sky={d.img}>
            <div class="frame" role="img" aria-label={`The pasture at ${d.t.toLowerCase()}`}><Screen name={d.img} /></div>
            <figcaption class="mono"><span>{d.t}</span><span class="dim">{d.time}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap sideways">
      <p class="mono orange">The bad days too</p>
      <h2 class="display section-title" data-words>Designed for when things go sideways.</h2>
      <div class="grid">
        {sideways.map((s) => (
          <figure data-rise>
            <div class="frame" role="img" aria-label={s.t}><Screen name={s.img} /></div>
            <figcaption><b>{s.t}</b><span>{s.d}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap how" id="how">
      <p class="mono orange">How it works</p>
      <h2 class="display section-title" data-words>Your tailnet. Your bridge. No cloud in between.</h2>
      <div class="diagram-scroll"><svg class="diagram" viewBox="0 0 1200 300" role="img" aria-label="The R1 talks over Tailscale to a bridge on your computer, which reaches Herdr on every host over SSH">
        <path class="wire" id="w1" d="M210 150 C 330 150, 360 150, 480 150" />
        <path class="wire" id="w2" d="M720 150 C 820 150, 860 60, 960 60" />
        <path class="wire" id="w3" d="M720 150 L 960 150" />
        <path class="wire" id="w4" d="M720 150 C 820 150, 860 240, 960 240" />
        <g class="node r1node"><rect x="20" y="95" width="190" height="110" rx="26" /><text x="44" y="146" style="fill:#0a0a0a">Rabbit R1</text><text class="m" x="44" y="176" style="fill:#3a1505">HERDR OS</text></g>
        <text class="m" x="270" y="132">TAILSCALE</text>
        <g class="node"><rect x="480" y="95" width="240" height="110" rx="26" /><text x="504" y="146">Herdr bridge</text><text class="m" x="504" y="176">ON YOUR COMPUTER</text></g>
        <text class="m" x="770" y="104">SSH</text>
        <g class="node"><rect x="960" y="20" width="220" height="80" rx="22" /><text x="984" y="58">cerebro</text><text class="m" x="984" y="82">HERDR · 2 AGENTS</text></g>
        <g class="node"><rect x="960" y="110" width="220" height="80" rx="22" /><text x="984" y="148">macbook</text><text class="m" x="984" y="172">HERDR · 14 AGENTS</text></g>
        <g class="node"><rect x="960" y="200" width="220" height="80" rx="22" /><text x="984" y="238">namek</text><text class="m" x="984" y="262">HERDR · 1 AGENT</text></g>
        <circle class="pulse" r="6" data-pulse="w1" /><circle class="pulse" r="5" data-pulse="w2" /><circle class="pulse" r="5" data-pulse="w3" /><circle class="pulse" r="5" data-pulse="w4" />
      </svg></div>
      <div class="facts">
        <div class="fact" data-rise><span class="mono orange">Reads the source</span><b>Each harness's own files.</b><p>Model, effort, context, subagents, background commands and the conversation come from the session files and stores the agents already write.</p></div>
        <div class="fact" data-rise><span class="mono orange">Answers are bound</span><b>To the exact question.</b><p>Every decision carries a fingerprint of what you were shown. If the agent moved on, a stale answer is refused, not delivered.</p></div>
        <div class="fact" data-rise><span class="mono orange">Private by default</span><b>Nothing leaves your network.</b><p>The R1 pairs with a bridge you run, over your own Tailscale tailnet, with a one-time code and scoped tokens you can revoke.</p></div>
      </div>
    </section>

    <section class="wrap install" id="install">
      <div class="install-head">
        <p class="mono orange">From stock to herd</p>
        <h2 class="display section-title" data-words>Your R1, from the box to Herdr OS.</h2>
        <p class="dim lede-sm">Six steps, about forty minutes. Chrome does the flashing for you over USB: plug the R1 in and follow the installer. It erases the R1 and voids Rabbit's warranty, so it says so before every step that does.</p>
        <div class="ctas"><a class="pill orange" href="/install">Install from Chrome</a><a class="pill ghost" href="#downloads">Downloads</a></div>
      </div>
      <ol class="journey">
        {steps.map((s) => (
          <li data-rise>
            <div class="when mono"><span class={s.chrome ? "orange" : "dim"}>{s.chrome ? "Chrome does it" : s.where}</span><span class="dim">{s.time}</span></div>
            <b>{s.title}</b>
            <p class="dim">{s.body}</p>
            {s.code && <code>{s.code}</code>}
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap downloads" id="downloads">
      <div>
        <p class="mono orange">Downloads · <span class="dim">{manifest.version}</span></p>
        <h2 class="display section-title">Everything the installer sends.</h2>
        <p class="dim lede-sm">The installer checks every file against these SHA-256 sums before it sends anything to your R1. Preview builds are signed with the developer's key; signed releases will update themselves.</p>
      </div>
      <ul class="files">
        {manifest.files.map((f) => (
          <li>
            <a class="file" href={f.url} download>
              <span><b>{f.name}</b><span class="dim">{f.what}</span></span>
              <span class="mono dim size">{f.bytes < 1048576 ? `${Math.round(f.bytes / 1024)} KB` : `${(f.bytes / 1048576).toFixed(1)} MB`}</span>
            </a>
            <code class="sum" title="SHA-256">{f.sha256}</code>
          </li>
        ))}
        <li class="dim from">From their makers, picked on your own disk by the installer: <a href="https://github.com/rabbit-hmi-oss/firmware/releases">rabbitOS v0.8.293</a> (for its verified-boot and empty-data images) and <a href="https://sourceforge.net/projects/andyyan-gsi/files/">LineageOS 21 GSI</a> (the <code class="inline">arm64_bvN</code> file).</li>
      </ul>
    </section>

    <footer class="wrap">
      <div class="big">Herdr<b>OS</b></div>
      <span>A fan-made OS for the Rabbit R1 and Herdr. Not affiliated with Rabbit Inc., Anthropic, OpenAI, Pi or OpenCode.</span>
      <span class="mono">Made with a herd of agents</span>
    </footer>
  </main>

  <script>
    import "../scripts/motion.ts";
  </script>
</body>
</html>
