---
import "../styles/global.css";
import Screen from "../components/Screen.astro";

import harnesses from "../harnesses.json";

const chapters = [
  { n: "01", tag: "Rest", title: "It naps until you’re needed.", body: "Pick it up and it tells you what you missed.", screens: ["asleep", "briefing", "pasture"] },
  { n: "02", tag: "Answer", title: "Questions come one at a time.", body: "Each agent asks in its own colors. One tap answers.", screens: ["asks"] },
  { n: "03", tag: "Talk", title: "Hold the button. Just talk.", body: "It passes it on and reads the reply back to you.", screens: ["walkie-you", "walkie-it"] },
  { n: "04", tag: "Show", title: "Show it what you mean.", body: "Snap the whiteboard. Your agent sees it right away.", screens: ["camera", "photo-sent", "thread"] },
  { n: "05", tag: "Peek", title: "Curious? Peek in.", body: "See how the work is going, away from your desk.", screens: ["subagents", "tasks", "terminal"] },
  { n: "06", tag: "Ask", title: "Give the next job out loud.", body: "Say what you need. It finds the right agent.", screens: ["model", "new-task"] },
];
const screens = [...new Set(chapters.flatMap((c) => c.screens))];

import manifest from "../../public/downloads/manifest.json";

const steps = [
  { where: "On the R1 and rabbit hole", time: "10 min", chrome: false, title: "Turn on developer mode and ask Rabbit to unlock", body: "In rabbit hole, under settings, r1, void the warranty to enable developer mode, then choose device modification, unlock. Rabbit's servers allow the unlock; nothing changes on the R1 yet." },
  { where: "", time: "2 min", chrome: true, title: "Unlock the bootloader", body: "Plug in the powered-off R1. The installer catches its preloader, puts it in fastboot and unlocks it. This wipes the R1." },
  { where: "", time: "10 min", chrome: true, title: "Install a clean Android base", body: "Swaps Rabbit's software for LineageOS, the open Android Herdr OS runs on." },
  { where: "", time: "3 min", chrome: true, title: "Hand the R1 over to Herdr OS", body: "Gives Herdr OS the whole device. You keep a copy of the original to undo it." },
  { where: "", time: "3 min", chrome: true, title: "Install Herdr OS", body: "Makes it the home screen and restarts the R1 into it." },
  { where: "On your computer", time: "5 min", chrome: false, title: "Introduce it to your agents", body: "Run the bridge where your agents live. Scan its code with the R1 and your herd appears.", code: "npm i -g @herdr-os/bridge && herdr-bridge serve --tailscale" },
];

const sideways = [
  { img: "rate-limited", t: "Out of usage", d: "It waits for the reset, or switches if you say so." },
  { img: "context-full", t: "Context full", d: "It tidies up so your agent can keep going." },
  { img: "host-down", t: "A computer goes quiet", d: "It tells you. Everyone else keeps going." },
  { img: "answered", t: "Already answered", d: "Someone beat you to it. Nothing is sent twice." },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Herdr OS · a herd in your hand</title>
  <meta name="description" content="Herdr OS turns your Rabbit R1 into a small companion that keeps an eye on your coding agents and tells you when one needs you." />
  <meta name="theme-color" content="#000000" />
  <link rel="icon" href="/sheep/sheep-plain.svg" type="image/svg+xml" />
  <meta property="og:title" content="Herdr OS · a herd in your hand" />
  <meta property="og:description" content="Your agents keep working when you walk away. Your R1 keeps you company and tells you when they need you." />
  <meta property="og:image" content="/og/pasture.webp" />
</head>
<body>
  <nav class="nav">
    <a class="brand" href="#top"><img src="/sheep/sheep-plain.svg" alt="" />Herdr<b>OS</b></a>
    <ul class="mono">
      <li><a href="#journeys">Journeys</a></li>
      <li><a href="#how">How it works</a></li>
      <li><a href="#install">Install</a></li>
      <li><a href="https://github.com/herdr-os/core">GitHub</a></li>
    </ul>
    <a class="pill orange" href="/install">Install</a>
  </nav>

  <main id="top">
    <section class="wrap hero">
      <div>
        <p class="mono kicker dim">Herdr OS for the Rabbit R1</p>
        <h1 class="display" data-split>
          <span class="line">Your agents,</span>
          <span class="line">a herd in</span>
          <span class="line orange">your hand.</span>
        </h1>
        <p class="lede" data-fade>Your R1 becomes a small companion. It keeps an eye on your coding agents while you get on with your day, and taps you on the shoulder when one needs you.</p>
        <div class="ctas" data-fade>
          <a class="pill orange" href="#journeys">Meet it</a>
          <a class="pill ghost" href="#install">Set it up</a>
        </div>
      </div>
      <div class="stage">
        <div class="ground"></div>
        <div class="r1" data-hero-r1>
          <div class="screen" role="img" aria-label="The Herdr OS pasture: agents as sheep, one asking a question"><Screen name="pasture" /></div>
          <div class="pocket cam"></div><div class="pocket wheel"><i data-wheel></i></div><div class="ptt"></div>
        </div>
        <img class="float-sheep" style="left:-4%;top:6%" src="/sheep/brand-claude.svg" alt="" data-float />
        <img class="float-sheep" style="right:-2%;top:-6%" src="/sheep/brand-pi.svg" alt="" data-float />
        <img class="float-sheep" style="right:-6%;bottom:2%" src="/sheep/brand-codex.svg" alt="" data-float />
        <img class="float-sheep" style="left:2%;bottom:-4%" src="/sheep/brand-opencode-sleep.svg" alt="" data-float />
      </div>
      <div class="scroll-cue mono dim"><span></span>Scroll</div>
    </section>

    <section class="wrap how why" aria-label="Why a whole OS">
      <p class="mono orange">Why a whole OS</p>
      <h2 class="display section-title" data-words>Not an app. A companion with one job.</h2>
      <div class="facts">
        <div class="fact" data-rise><span class="mono orange">All yours</span><b>It only does this.</b><p>Nothing else asks for your attention.</p></div>
        <div class="fact" data-rise><span class="mono orange">Fits your hand</span><b>Wheel, button, touch.</b><p>Roll, hold to talk, tap to answer.</p></div>
        <div class="fact" data-rise><span class="mono orange">Always nearby</span><b>On the desk or in your pocket.</b><p>Pick it up and it tells you what's new.</p></div>
      </div>
    </section>

    <section class="wrap herd">
      <p class="mono orange">Its herd · {harnesses.length} kinds of agent</p>
      <h2 class="display section-title" data-words>Your agents become its herd.</h2>
    </section>
    <div class="carousel" aria-label={`Every harness Herdr runs: ${harnesses.map((h) => h.label).join(", ")}`} data-carousel>
      <ul class="track">
        {[0, 1].map((copy) => harnesses.map((h) => (
          <li class="sheep-card" style={`--c:${h.color};--ink:${h.ink}`} aria-hidden={copy ? "true" : undefined}>
            <span class="mono">{h.note}</span>
            <img src={`/sheep/brand-${h.id}.svg`} alt="" loading="lazy" />
            <span class="name">{h.label}</span>
          </li>
        )))}
      </ul>
    </div>
    <section class="wrap herd-after">
      <p class="note dim">The plain sheep is your companion. The others are your agents, each in its maker's colors.</p>
    </section>

    <section class="wrap principles" aria-label="Its manners">
      <p class="mono orange">Its manners</p>
      <div class="stmt display" data-reveal>Orange is you.<small>If it's orange, it's waiting on you.</small></div>
      <div class="stmt display" data-reveal>It never says yes for you.<small>Your voice drafts. Your finger decides.</small></div>
      <div class="stmt display" data-reveal>If it doesn't know, it says so.<small>No guessing to fill a gap.</small></div>
    </section>

    <section class="journeys" id="journeys" data-journeys>
      <div class="wrap pin">
        <div class="device">
          <div class="r1">
            <div class="screen">
              {screens.map((s, i) => <Screen name={s} hidden={i > 0} />)}
            </div>
            <div class="pocket cam"></div><div class="pocket wheel"><i data-wheel></i></div><div class="ptt"></div>
          </div>
        </div>
        <div class="chapters">
          <div class="stack">
            {chapters.map((c) => (
              <article class="chapter" data-chapter data-screens={c.screens.join(",")}>
                <p class="mono"><span class="orange">{c.n}</span> <span class="dim">· {c.tag}</span></p>
                <h3 class="display">{c.title}</h3>
                <p>{c.body}</p>
              </article>
            ))}
          </div>
          <div class="rail" aria-hidden="true">{chapters.map(() => <i><b /></i>)}</div>
        </div>
      </div>
    </section>

    <section class="wrap hosts">
      <div>
        <p class="mono orange">Every machine</p>
        <h2 class="display section-title" data-words>However big the herd, one friend keeps it.</h2>
        <p class="dim" style="margin-top:24px;max-width:44ch">Agents on every computer you own, gathered in one place.</p>
        <div class="chips mono"><span>laptop</span><span>desktop</span><span>server</span></div>
      </div>
      <div class="shots" data-shots>
        <div class="shot frame" style="left:0;top:6%" role="img" aria-label="The pasture folded into one flock per host"><Screen name="flocks" /></div>
        <div class="shot frame" style="right:0;top:22%" role="img" aria-label="Every agent as a deck of harness-colored cards"><Screen name="cards" /></div>
      </div>
    </section>

    <section class="wrap sideways">
      <p class="mono orange">The bad days too</p>
      <h2 class="display section-title" data-words>It tells you when things go wrong.</h2>
      <div class="grid">
        {sideways.map((s) => (
          <figure data-rise>
            <div class="frame" role="img" aria-label={s.t}><Screen name={s.img} /></div>
            <figcaption><b>{s.t}</b><span>{s.d}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="wrap how" id="how">
      <p class="mono orange">How it works</p>
      <h2 class="display section-title" data-words>Private by design. No cloud in between.</h2>
      <div class="diagram-scroll"><svg class="diagram" viewBox="0 0 1200 300" role="img" aria-label="The R1 talks over Tailscale to a bridge on your computer, which reaches Herdr on every host over SSH">
        <path class="wire" id="w1" d="M210 150 C 330 150, 360 150, 480 150" />
        <path class="wire" id="w2" d="M720 150 C 820 150, 860 60, 960 60" />
        <path class="wire" id="w3" d="M720 150 L 960 150" />
        <path class="wire" id="w4" d="M720 150 C 820 150, 860 240, 960 240" />
        <g class="node r1node"><rect x="20" y="95" width="190" height="110" rx="26" /><text x="44" y="146" style="fill:#0a0a0a">Rabbit R1</text><text class="m" x="44" y="176" style="fill:#3a1505">HERDR OS</text></g>
        <text class="m" x="270" y="132">TAILSCALE</text>
        <g class="node"><rect x="480" y="95" width="240" height="110" rx="26" /><text x="504" y="146">Herdr bridge</text><text class="m" x="504" y="176">ON YOUR COMPUTER</text></g>
        <text class="m" x="770" y="104">SSH</text>
        <g class="node"><rect x="960" y="20" width="220" height="80" rx="22" /><text x="984" y="58">laptop</text><text class="m" x="984" y="82">HERDR · 2 AGENTS</text></g>
        <g class="node"><rect x="960" y="110" width="220" height="80" rx="22" /><text x="984" y="148">desktop</text><text class="m" x="984" y="172">HERDR · 14 AGENTS</text></g>
        <g class="node"><rect x="960" y="200" width="220" height="80" rx="22" /><text x="984" y="238">server</text><text class="m" x="984" y="262">HERDR · 1 AGENT</text></g>
        <circle class="pulse" r="6" data-pulse="w1" /><circle class="pulse" r="5" data-pulse="w2" /><circle class="pulse" r="5" data-pulse="w3" /><circle class="pulse" r="5" data-pulse="w4" />
      </svg></div>
      <div class="facts">
        <div class="fact" data-rise><span class="mono orange">Works with what you use</span><b>Claude Code, Codex, Pi, OpenCode.</b><p>No plugins. Nothing changes on your side.</p></div>
        <div class="fact" data-rise><span class="mono orange">Careful with your yes</span><b>Never approves the wrong thing.</b><p>If the question changed, nothing is sent.</p></div>
        <div class="fact" data-rise><span class="mono orange">Stays home</span><b>Nothing leaves your network.</b><p>It only talks to your own computer.</p></div>
      </div>
    </section>

    <section class="wrap install" id="install">
      <div class="install-head">
        <p class="mono orange">From stock to herd</p>
        <h2 class="display section-title" data-words>Your R1, from the box to Herdr OS.</h2>
        <p class="dim lede-sm">About forty minutes, mostly waiting. Plug the R1 into a computer with Chrome. This erases the R1 and voids Rabbit's warranty; it warns you before each step that does.</p>
        <div class="ctas"><a class="pill orange" href="/install">Install from Chrome</a><a class="pill ghost" href="#downloads">Downloads</a></div>
      </div>
      <ol class="journey">
        {steps.map((s) => (
          <li data-rise>
            <div class="when mono"><span class={s.chrome ? "orange" : "dim"}>{s.chrome ? "Chrome does it" : s.where}</span><span class="dim">{s.time}</span></div>
            <b>{s.title}</b>
            <p class="dim">{s.body}</p>
            {s.code && <code>{s.code}</code>}
          </li>
        ))}
      </ol>
    </section>

    <section class="wrap downloads" id="downloads">
      <div>
        <p class="mono orange">Downloads · <span class="dim">{manifest.version}</span></p>
        <h2 class="display section-title">Everything the installer sends.</h2>
        <p class="dim lede-sm">Prefer doing it by hand? These are the installer's exact files, with checksums.</p>
      </div>
      <ul class="files">
        {manifest.files.map((f) => (
          <li>
            <a class="file" href={f.url} download>
              <span><b>{f.name}</b><span class="dim">{f.what}</span></span>
              <span class="mono dim size">{f.bytes < 1048576 ? `${Math.round(f.bytes / 1024)} KB` : `${(f.bytes / 1048576).toFixed(1)} MB`}</span>
            </a>
            <code class="sum" title="SHA-256">{f.sha256}</code>
          </li>
        ))}
        <li class="dim from">From their makers, picked on your own disk by the installer: <a href="https://github.com/rabbit-hmi-oss/firmware/releases">rabbitOS v0.8.293</a> (for its verified-boot and empty-data images) and <a href="https://sourceforge.net/projects/andyyan-gsi/files/">LineageOS 21 GSI</a> (the <code class="inline">arm64_bvN</code> file).</li>
      </ul>
    </section>

    <footer class="wrap">
      <div class="big">Herdr<b>OS</b></div>
      <span>A fan-made OS for the Rabbit R1 and Herdr. Not affiliated with Rabbit Inc., Anthropic, OpenAI, Pi or OpenCode.</span>
      <span class="mono"><a href="https://github.com/herdr-os/core">GitHub</a> · Made with a herd of agents</span>
    </footer>
  </main>

  <script>
    import "../scripts/motion.ts";
  </script>
</body>
</html>
